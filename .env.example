# Gemini API Key for Vision extraction and Adversarial counter-prompts
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Twilio WhatsApp Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_CONTENT_SID=

# Security & Authentication Secret (HMAC-SHA256)
MEDLENS_AUTH_SECRET=generate_a_random_32_byte_secret_here

# Database URL (SQLite or Neon/PostgreSQL)
# SQLite: sqlite:///./medlens.db
# Neon PostgreSQL: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./medlens.db

MEDLENS_PORT=8000

